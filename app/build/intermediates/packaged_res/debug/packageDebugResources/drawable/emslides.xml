<?xml version="1.0" encoding="utf-8"?>
<!--
  List-row glass. A single shape rather than the two-rim stack used elsewhere: rows carry
  their own content padding via <padding>, which only a plain <shape> declares reliably
  across the minSdk 24 range, and a row is small enough that one rim is enough edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/glass_card_bottom"
        android:startColor="@color/glass_card_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_rim" />
    <padding
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp" />
</shape>
