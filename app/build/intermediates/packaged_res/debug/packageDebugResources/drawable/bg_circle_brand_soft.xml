<?xml version="1.0" encoding="utf-8"?>
<!-- Back button: a brand-tinted glass disc. Same material as the header bands so the
     navigation reads as part of the chrome, not as a control dropped onto the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:endColor="@color/header_glass_bottom"
        android:startColor="@color/header_glass_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_border_soft" />
</shape>
