<?xml version="1.0" encoding="utf-8"?>
<!-- Emergency header. The one place a non-brand hue is allowed to tint the glass:
     urgency is content on these screens, so it earns colour an ordinary header does not. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/header_danger_bottom"
                android:startColor="@color/header_danger_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/danger_border" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim_inner" />
        </shape>
    </item>

</layer-list>
