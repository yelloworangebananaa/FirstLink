<?xml version="1.0" encoding="utf-8"?>
<!-- The same well, for a field sitting inside a glass panel. The rim is brand-tinted
     because this is the join-code field: it is the one input the whole screen exists for,
     so it gets the accent edge that ordinary fields do not. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_well_bottom"
                android:startColor="@color/glass_well_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_border_soft" />
        </shape>
    </item>

</layer-list>
