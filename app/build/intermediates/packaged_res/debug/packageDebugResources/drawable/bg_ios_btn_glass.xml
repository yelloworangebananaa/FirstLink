<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent liquid-glass capsule button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_fill" />
            <stroke android:width="1dp" android:color="@color/glass_rim_inner" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_card_bottom"
                android:startColor="@color/glass_card_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/brand_border_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_sheen_bottom"
                android:startColor="@color/glass_sheen_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/glass_rim" />
        </shape>
    </item>
</selector>
