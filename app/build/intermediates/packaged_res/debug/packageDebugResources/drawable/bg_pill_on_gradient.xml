<?xml version="1.0" encoding="utf-8"?>
<!-- Inline highlight behind one word of the headline. Brand-tinted glass: on a blue field
     a grey pill reads as a text-selection artefact, a blue one reads as emphasis. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/header_glass_bottom"
        android:startColor="@color/header_glass_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_border_soft" />
</shape>
