<?xml version="1.0" encoding="utf-8"?>
<!-- Layered field behind every glass surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/page_bottom"
                android:startColor="@color/page_top"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.08"
                android:centerY="0.02"
                android:endColor="@color/bloom_brand_clear"
                android:gradientRadius="0.78"
                android:startColor="@color/bloom_brand"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.92"
                android:centerY="0.34"
                android:endColor="@color/bloom_sky_clear"
                android:gradientRadius="0.7"
                android:startColor="@color/bloom_sky"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.2"
                android:centerY="0.96"
                android:endColor="@color/bloom_white_clear"
                android:gradientRadius="0.58"
                android:startColor="@color/bloom_white"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
