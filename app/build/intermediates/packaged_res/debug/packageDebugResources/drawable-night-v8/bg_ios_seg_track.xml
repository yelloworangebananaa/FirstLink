<?xml version="1.0" encoding="utf-8"?>
<!-- Dark recessed segmented-control track. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/glass_well_bottom"
        android:startColor="@color/glass_well_top"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/glass_rim_inner" />
</shape>
