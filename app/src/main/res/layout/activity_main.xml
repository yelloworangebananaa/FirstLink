<?xml version="1.0" encoding="utf-8"?>
<!--
  HomeView (Onboarding.swift).

  Navigation root: no back chevron. A 44dp inline nav bar carrying only the trailing
  gear, a vertically centred hero column (Spacer / VStack(spacing: 18) / Spacer), and a
  bottom safeAreaBar holding the two actions inside thumb reach.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_glass"
    tools:context=".MainActivity">

    <!-- Nav bar: 44dp tall, empty except the topBarTrailing settings item. -->
    <ImageButton
        android:id="@+id/home_settings_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sf_gearshape_fill"
        android:tint="@color/brand_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hero column, centred in the space between the nav bar and the action bar. -->
    <LinearLayout
        android:id="@+id/home_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/home_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/home_settings_button">

        <ImageView
            android:id="@+id/home_logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sf_cross_case_fill"
            android:tint="@color/brand_primary" />

        <TextView
            android:id="@+id/Firstlink_title_homepage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif"
            android:text="FirstLink"
            android:textColor="@color/text_primary"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/description_home_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="Connect organizers with qualified attendees while emergency services are on the way."
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- safeAreaBar(edge: .bottom): PrimaryAction over SecondaryAction, 12dp apart. -->
    <LinearLayout
        android:id="@+id/home_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- .glassProminent -->
        <com.example.firstlink.widget.DraggableMaterialButton
            android:id="@+id/join_btn"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:stateListAnimator="@null"
            android:text="Join Event"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="28dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_sf_qrcode_viewfinder"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeWidth="0dp" />

        <!-- .glass -->
        <com.example.firstlink.widget.DraggableMaterialButton
            android:id="@+id/create_btn"
            style="@style/Widget.FirstLink.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:stateListAnimator="@null"
            android:text="Create Event"
            android:textColor="@color/brand_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/card_surface"
            app:cornerRadius="28dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_sf_plus_circle"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/brand_primary"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
