<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qualifications"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/qualifications_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="56dp"
            android:text="Your Qualifications"
            android:textColor="#111111"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qualifications_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="If you are qualified to respond to medical emergencies, you can receive emergency alerts during this event."
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/qual_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Your name"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/qual_name"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="First and last name"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111111"
            android:textColorHint="#9CA3AF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/qual_name_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Event staff see your name so they know who responded."
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/qual_skills_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your qualifications"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/qual_cpr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CPR Certified"
            android:textColor="#111111"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/qual_first_aid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First Aid Certified"
            android:textColor="#111111"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/qual_aed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AED Trained"
            android:textColor="#111111"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/qual_medical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medical Professional"
            android:textColor="#111111"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/qual_nurse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nurse"
            android:textColor="#111111"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/qual_emt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMT or Paramedic"
            android:textColor="#111111"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/qual_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other"
            android:textColor="#111111"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/qual_other_text"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/edit_text"
            android:hint="Describe your other qualification (optional)"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111111"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/qual_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No Qualifications"
            android:textColor="#111111"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_qualifications_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="Save Qualifications"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#3F51B5"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip_qualifications_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:text="Skip"
            android:textAllCaps="false"
            android:textColor="#6B7280"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
