<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qualifications"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.FirstLink.BackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:id="@+id/qualifications_header_card"
            style="@style/Widget.FirstLink.HeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.FirstLink.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responder profile"
                android:textColor="@color/on_gradient_muted" />

            <TextView
                android:id="@+id/qualifications_title"
                style="@style/TextAppearance.FirstLink.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your Qualifications" />

            <TextView
                android:id="@+id/qualifications_subtitle"
                style="@style/TextAppearance.FirstLink.HeroBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="If you are qualified to respond to medical emergencies, you can receive emergency alerts during this event." />
        </LinearLayout>

        <TextView
            android:id="@+id/qual_name_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="26dp"
            android:text="Your name" />

        <EditText
            android:id="@+id/qual_name"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="First and last name"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/qual_name_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:text="Event staff see your name so they know who responded."
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/qual_skills_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp"
            android:text="Your qualifications" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FirstLink.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <CheckBox
                    android:id="@+id/qual_cpr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="CPR Certified"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/qual_first_aid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="First Aid Certified"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/qual_aed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="AED Trained"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/qual_medical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Medical Professional"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/qual_nurse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Nurse"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/qual_emt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="EMT or Paramedic"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/qual_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Other"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/qual_other_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Describe your other qualification (optional)"
                    android:inputType="textCapSentences"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/border_light" />

                <CheckBox
                    android:id="@+id/qual_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="No Qualifications"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_qualifications_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="Save Qualifications"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip_qualifications_button"
            style="@style/Widget.FirstLink.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:text="Skip"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
