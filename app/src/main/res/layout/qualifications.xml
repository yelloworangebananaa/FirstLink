<?xml version="1.0" encoding="utf-8"?>
<!-- QualificationsView (Onboarding.swift): back button hidden, name section, CheckRow list,
     pinned Save & Continue + Skip for now. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qualifications"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_glass"
    android:orientation="vertical">

    <!-- navigationBarBackButtonHidden(): title only. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:text="Responder Profile"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.04"
                android:text="NAME"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ios_group"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/qual_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="Your name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="36dp"
                android:lineSpacingMultiplier="1.25"
                android:text="Event staff see this so they know who responded."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.04"
                android:text="YOUR QUALIFICATIONS"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.example.firstlink.widget.DraggableCheckGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ios_group"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/qual_cpr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_heart_circle"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="CPR Certified"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_first_aid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_cross_case"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="First Aid Certified"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_aed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_bolt_heart"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="AED Trained"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_medical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_stethoscope"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Medical Professional"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_nurse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_cross_vial"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Nurse"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_emt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_truck_box"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="EMT or Paramedic"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_ellipsis_circle"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Other"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <!-- iOS: HStack { Image("ellipsis.circle"); TextField("Something else") } -->
                <EditText
                    android:id="@+id/qual_other_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="Something else"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:minHeight="44dp"
                    android:paddingStart="52dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <CheckBox
                    android:id="@+id/qual_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_sf_nosign"
                    android:drawableEnd="@drawable/bg_ios_check"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/brand_primary"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="No qualifications"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </com.example.firstlink.widget.DraggableCheckGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="36dp"
                android:lineSpacingMultiplier="1.25"
                android:text="Leave everything unchecked if you have none — you'll still be able to report emergencies and request help."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- safeAreaBar(edge: .bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <com.example.firstlink.widget.DraggableMaterialButton
            android:id="@+id/save_qualifications_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Save &amp; Continue"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="28dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_sf_checkmark"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeWidth="0dp" />

        <com.example.firstlink.widget.DraggableMaterialButton
            android:id="@+id/skip_qualifications_button"
            style="@style/Widget.FirstLink.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Skip for now"
            android:textColor="@color/brand_primary"
            android:textSize="15sp"
            app:elevation="0dp"
            app:strokeWidth="0dp" />
    </LinearLayout>
</LinearLayout>
