<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendee_main_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="44dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/attendee_dashboard_header_card"
            style="@style/Widget.FirstLink.HeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.FirstLink.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You're checked in"
                android:textColor="@color/on_gradient_muted" />

            <TextView
                android:id="@+id/attendee_main_dashboard_event_name"
                style="@style/TextAppearance.FirstLink.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Summer Hackathon" />

            <LinearLayout
                style="@style/Widget.FirstLink.FrostedBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/attendee_main_dashboard_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Event Live"
                    android:textColor="@color/on_gradient"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="•"
                    android:textColor="@color/on_gradient_faint"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendee"
                    android:textColor="@color/on_gradient_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call_911_approved_button"
            style="@style/Widget.FirstLink.Button.Success"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="911 Approved — Call Now"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/attendee_dashboard_actions_label"
            style="@style/TextAppearance.FirstLink.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="30dp"
            android:text="Need something?"
            android:textColor="@color/text_hint" />

        <!-- Deliberately plain, oversized solid buttons: this is the panic-moment surface,
             so it stays unmistakable rather than decorative. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendee_main_dashboard_report_emergency_button"
            style="@style/Widget.FirstLink.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="12dp"
            android:text="Report Emergency"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:text="Alerts event staff and nearby qualified responders immediately."
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendee_main_dashboard_request_help_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="18dp"
            android:text="Request Help"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:text="For non-emergencies: lost items, directions, accessibility."
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
