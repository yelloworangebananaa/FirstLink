<?xml version="1.0" encoding="utf-8"?>
<!-- Drill result. Brand blue, never red: red is reserved for the real emergency path. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ios_pill_blue"
            android:drawableStart="@drawable/ic_sf_figure_run"
            android:drawablePadding="10dp"
            android:drawableTint="@color/brand_primary"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="Drill mode — no alerts sent"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:text="Already here" />

        <TextView
            android:id="@+id/ready_drill_here"
            style="@style/SettingsValueRow"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ios_group"
            android:lineSpacingMultiplier="1.3"
            android:paddingTop="11dp"
            android:paddingBottom="11dp" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:text="Could be sent" />

        <TextView
            android:id="@+id/ready_drill_elsewhere"
            style="@style/SettingsValueRow"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ios_group"
            android:lineSpacingMultiplier="1.3"
            android:paddingTop="11dp"
            android:paddingBottom="11dp" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:text="AED" />

        <TextView
            android:id="@+id/ready_drill_aed"
            style="@style/SettingsValueRow"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ios_group"
            android:paddingTop="11dp"
            android:paddingBottom="11dp" />

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:text="911" />

        <TextView
            android:id="@+id/ready_drill_911"
            style="@style/SettingsValueRow"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ios_group"
            android:paddingTop="11dp"
            android:paddingBottom="11dp" />
    </LinearLayout>
</ScrollView>
