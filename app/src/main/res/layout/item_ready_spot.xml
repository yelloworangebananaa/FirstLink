<?xml version="1.0" encoding="utf-8"?>
<!-- ReadyMap tile. Status is always spelled out in text, so colour is never the only signal.
     Background and status pill are set per level by ReadyMapActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="6dp"
    android:background="@drawable/bg_ios_group"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="140dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/ready_spot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ios_pill_orange"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="Gap"
        android:textColor="@color/warning"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ready_spot_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Main Hall"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ready_spot_responders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_sf_person_fill"
        android:drawablePadding="6dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:text="No responders"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ready_spot_aed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_sf_bolt_heart"
        android:drawablePadding="6dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:text="No AED"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ready_spot_first_aid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_sf_cross_case"
        android:drawablePadding="6dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:text="No first-aid kit"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
