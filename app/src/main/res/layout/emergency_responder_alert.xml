<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emergency_responder_alert"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.FirstLink.BackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <!-- Danger header carries the urgency; the incident detail below stays a plain,
             high-contrast card so it is readable at a glance. -->
        <LinearLayout
            android:id="@+id/alert_header_card"
            style="@style/Widget.FirstLink.HeaderCard.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.FirstLink.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responder alert"
                android:textColor="@color/on_gradient_muted" />

            <TextView
                android:id="@+id/alert_title"
                style="@style/TextAppearance.FirstLink.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Emergency Alert" />

            <TextView
                android:id="@+id/alert_subtitle"
                style="@style/TextAppearance.FirstLink.HeroBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="A qualified responder is needed" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/alert_detail_card"
            style="@style/Widget.FirstLink.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/alert_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main Hall"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_patient_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_danger"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Unconscious • Not Breathing"
                    android:textColor="@color/danger"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Description"
                    android:textColor="@color/text_body"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/alert_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Reported at 3:15 PM"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/alert_responders_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="22dp"
            android:text="Qualified responders alerted" />

        <TextView
            android:id="@+id/alert_responders_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="No qualified responders have joined yet."
            android:textColor="@color/text_body"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/alert_accepted_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:text="Accepted by: nobody yet"
            android:textColor="@color/success"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_directions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:padding="18dp"
            android:text="Go to: Main Hall"
            android:textColor="@color/success"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alert_accept_button"
            style="@style/Widget.FirstLink.Button.Success"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="26dp"
            android:text="Accept Response"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alert_decline_button"
            style="@style/Widget.FirstLink.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Cannot Respond"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
