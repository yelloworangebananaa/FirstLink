<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendee_emergency"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/attendee_emergency_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="56dp"
            android:text="Report Emergency"
            android:textColor="#111111"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/attendee_emergency_location_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Location"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/attendee_emergency_location_spinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/attendee_emergency_description_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Description"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/attendee_emergency_description"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top|start"
            android:hint="Describe what is happening..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="#111111"
            android:textColorHint="#9CA3AF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/attendee_emergency_consciousness_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Consciousness"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/attendee_emergency_consciousness_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/attendee_emergency_conscious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conscious" />

            <RadioButton
                android:id="@+id/attendee_emergency_unconscious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unconscious" />

            <RadioButton
                android:id="@+id/attendee_emergency_consciousness_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown" />

        </RadioGroup>

        <TextView
            android:id="@+id/attendee_emergency_breathing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Breathing"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/attendee_emergency_breathing_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/attendee_emergency_breathing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breathing" />

            <RadioButton
                android:id="@+id/attendee_emergency_not_breathing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Breathing" />

            <RadioButton
                android:id="@+id/attendee_emergency_breathing_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendee_emergency_send_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="Send Emergency"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#DC2626"
            app:cornerRadius="18dp" />

    </LinearLayout>

</ScrollView>
