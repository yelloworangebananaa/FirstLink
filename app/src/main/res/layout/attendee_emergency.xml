<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendee_emergency"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.FirstLink.BackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <!-- Danger-tinted header only. The form itself stays plain white and high-contrast:
             this is filled in under stress and must never be decorative. -->
        <LinearLayout
            android:id="@+id/attendee_emergency_header_card"
            style="@style/Widget.FirstLink.HeaderCard.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.FirstLink.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medical emergency"
                android:textColor="@color/on_gradient_muted" />

            <TextView
                android:id="@+id/attendee_emergency_title"
                style="@style/TextAppearance.FirstLink.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Report Emergency" />

            <TextView
                style="@style/TextAppearance.FirstLink.HeroBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="If someone is in danger right now, call 911 first." />
        </LinearLayout>

        <TextView
            android:id="@+id/attendee_emergency_location_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="26dp"
            android:text="Location" />

        <Spinner
            android:id="@+id/attendee_emergency_location_spinner"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="18dp"
            android:paddingEnd="46dp" />

        <TextView
            android:id="@+id/attendee_emergency_description_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="22dp"
            android:text="Description" />

        <EditText
            android:id="@+id/attendee_emergency_description"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Describe what is happening..."
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:padding="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/attendee_emergency_consciousness_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="22dp"
            android:text="Consciousness" />

        <RadioGroup
            android:id="@+id/attendee_emergency_consciousness_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/attendee_emergency_conscious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Conscious"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/attendee_emergency_unconscious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unconscious"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/attendee_emergency_consciousness_unknown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unknown"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/attendee_emergency_breathing_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:text="Breathing" />

        <RadioGroup
            android:id="@+id/attendee_emergency_breathing_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/attendee_emergency_breathing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Breathing"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/attendee_emergency_not_breathing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not Breathing"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/attendee_emergency_breathing_unknown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unknown"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendee_emergency_send_button"
            style="@style/Widget.FirstLink.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="26dp"
            android:text="Send Emergency"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
