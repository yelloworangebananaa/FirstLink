<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staff_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/staff_dashboard_event_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="Summer Hackathon"
        android:textColor="#111827"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/staff_dashboard_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="● Event Live"
        android:textColor="#16A34A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/staff_dashboard_event_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/call_911_approved_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="28dp"
        android:text="911 Approved — Call Now"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="#16A34A"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/staff_dashboard_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/staff_dashboard_emergency_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="28dp"
        app:cardBackgroundColor="#FFF5F5"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="#FECACA"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/call_911_approved_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/staff_dashboard_emergency_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency"
                android:textColor="#991B1B"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/staff_dashboard_emergency_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Report emergencies or view all active incidents."
                android:textColor="#7F1D1D"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/staff_dashboard_report_emergency_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Report Emergency"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#DC2626"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/staff_dashboard_show_emergencies_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="View Active Emergencies"
                android:textAllCaps="false"
                android:textColor="#DC2626"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#DC2626"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/staff_dashboard_help_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="28dp"
        app:cardBackgroundColor="#F3F6FF"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="#D8DCFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/staff_dashboard_emergency_card"
        app:layout_constraintBottom_toTopOf="@id/staff_dashboard_end_event_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/staff_dashboard_help_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help Requests"
                android:textColor="#1E3A8A"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/staff_dashboard_help_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Handle attendee assistance requests."
                android:textColor="#374151"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/staff_dashboard_request_help_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Request Help"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#3F51B5"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/staff_dashboard_show_help_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="View Help Requests"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                app:cornerRadius="16dp"
                app:strokeColor="#3F51B5"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/staff_dashboard_end_event_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="4dp"
        android:text="End Event"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="#6B7280"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>