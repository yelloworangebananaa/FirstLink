<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staff_view_emergencies"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ImageButton
        android:id="@+id/back_button"
        style="@style/Widget.FirstLink.BackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Compact danger header only. The rows below are data-dense and stay plain white. -->
    <LinearLayout
        android:id="@+id/emergencies_header_card"
        style="@style/Widget.FirstLink.HeaderCard.Danger"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button">

        <TextView
            style="@style/TextAppearance.FirstLink.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live incidents"
            android:textColor="@color/on_gradient_muted" />

        <TextView
            android:id="@+id/staff_view_emergency_title"
            style="@style/TextAppearance.FirstLink.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Active Emergencies"
            android:textSize="27sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emergencies_empty_state"
        style="@style/TextAppearance.FirstLink.PageSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="No emergencies have been reported."
        android:textColor="@color/text_hint"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emergencies_header_card" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emergencies_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emergencies_header_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
