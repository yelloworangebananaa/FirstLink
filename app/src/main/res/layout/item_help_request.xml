<?xml version="1.0" encoding="utf-8"?>
<!-- Data-dense row: plain white card, hairline border, brand-tinted status chip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/emslides"
    android:clipToOutline="true"
    android:elevation="2dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/item_help_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Main Hall"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_help_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="Description"
        android:textColor="@color/text_body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/item_help_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Submitted at 3:15 PM"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/item_help_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_brand"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="Open"
        android:textColor="@color/brand_on_primary_container"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_help_resolve_button"
        style="@style/Widget.FirstLink.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="Mark Resolved"
        android:textColor="@color/success"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
