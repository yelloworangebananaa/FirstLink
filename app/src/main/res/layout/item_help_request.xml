<?xml version="1.0" encoding="utf-8"?>
<!-- HelpListView row: description is the headline, location and time recede beneath it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="14dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bg_ios_group"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Preset problem the reporter tapped, when they tapped one. -->
    <TextView
        android:id="@+id/item_help_problem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ios_pill_blue"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="Water problem"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/item_help_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        android:text="Someone needs a hand at the front desk."
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_help_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_sf_mappin_circle"
        android:drawablePadding="6dp"
        android:drawableTint="@color/text_secondary"
        android:text="Main Hall"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/item_help_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Submitted at 10:24"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- StatusPill. -->
    <TextView
        android:id="@+id/item_help_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_ios_pill_blue"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="Open"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        android:textStyle="bold" />


    <ImageView
        android:id="@+id/item_help_photo"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="Photo from the reporter"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/item_help_accepted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Accepted by Sam"
        android:textColor="@color/success"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Only rendered for staff who accepted this request. -->
    <TextView
        android:id="@+id/item_help_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ios_pill_blue"
        android:padding="10dp"
        android:text="Contact: Dana Reyes"
        android:textColor="@color/brand_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.example.firstlink.widget.DraggableMaterialButton
        android:id="@+id/item_help_accept_button"
        style="@style/Widget.FirstLink.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:elevation="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        android:text="Accept Request"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_primary"
        app:cornerRadius="20dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_sf_hand_raised_fill"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="16dp"
        app:iconTint="@color/white"
        app:strokeWidth="0dp" />

    <!-- iOS puts this behind a swipe; Android needs a visible target, so: a glass capsule. -->
    <com.example.firstlink.widget.DraggableMaterialButton
        android:id="@+id/item_help_resolve_button"
        style="@style/Widget.FirstLink.Button.Neutral"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:elevation="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        android:text="Mark Resolved"
        android:textColor="@color/success"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/card_surface"
        app:cornerRadius="20dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_sf_checkmark_circle_fill"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="16dp"
        app:iconTint="@color/success"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp" />

</LinearLayout>
