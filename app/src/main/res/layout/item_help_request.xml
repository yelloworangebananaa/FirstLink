<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:background="@drawable/emslides"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/item_help_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Main Hall"
        android:textColor="#111827"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_help_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Description"
        android:textColor="#374151"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/item_help_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Submitted at 3:15 PM"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/item_help_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Open"
        android:textColor="#3F51B5"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_help_resolve_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="Mark Resolved"
        android:textAllCaps="false"
        android:textColor="#16A34A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:strokeColor="#16A34A" />

</LinearLayout>
