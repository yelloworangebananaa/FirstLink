<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3 of 4: the problem -> person map that drives the help screen's preset buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/important_people"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_glass"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Important People"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/brand_primary" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- StepHeader: progress capsules, step caption, large title, subtitle. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_off" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:text="Step 3 of 4"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:text="Important People"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingMultiplier="1.25"
                android:text="Name a problem and who handles it. Each one becomes a button on the help screen, and gets its own join code — give it to that person so requests for their problem reach them too."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.04"
                android:text="ADD A PROBLEM"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ios_group"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/important_problem_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Water problem"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:minHeight="44dp"
                    android:padding="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_ios_separator" />

                <EditText
                    android:id="@+id/important_person_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Who to contact — e.g. Dana Reyes, ext. 214"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:minHeight="44dp"
                    android:padding="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="17sp" />
            </LinearLayout>

            <com.example.firstlink.widget.DraggableMaterialButton
                android:id="@+id/important_add_button"
                style="@style/Widget.FirstLink.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="Add"
                android:textColor="@color/brand_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/card_surface"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_sf_plus_circle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="16dp"
                app:iconTint="@color/brand_primary"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.04"
                android:text="PROBLEMS"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/important_list_text"
                android:textIsSelectable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ios_group"
                android:gravity="center_vertical"
                android:lineSpacingMultiplier="1.35"
                android:minHeight="44dp"
                android:padding="16dp"
                android:text="No problems have been added yet."
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <com.example.firstlink.widget.DraggableMaterialButton
            android:id="@+id/important_continue_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Continue"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="28dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_sf_arrow_right"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeWidth="0dp" />
    </LinearLayout>
</LinearLayout>
