<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:background="@drawable/emslides"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/item_emergency_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Main Hall"
        android:textColor="#111827"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_emergency_patient_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Unconscious • Not Breathing"
        android:textColor="#DC2626"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_emergency_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Description"
        android:textColor="#374151"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/item_emergency_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Reported at 3:15 PM"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/item_emergency_reporter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Reported by"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/item_emergency_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Active"
        android:textColor="#3F51B5"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_emergency_approval_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="911 call: waiting for organizer"
        android:textColor="#B45309"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/item_emergency_approval_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_emergency_approve_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:text="Approve 911"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#DC2626"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_emergency_deny_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="Deny"
            android:textAllCaps="false"
            android:textColor="#6B7280"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#9CA3AF" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_emergency_resolve_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="Mark Resolved"
        android:textAllCaps="false"
        android:textColor="#16A34A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:strokeColor="#16A34A" />

</LinearLayout>
