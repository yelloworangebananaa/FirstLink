<?xml version="1.0" encoding="utf-8"?>
<!-- RoomCodesView (Onboarding.swift) — StepHeader 3 of 3, two code plates with
     Copy/Share glass pairs, pinned bottom PrimaryAction.
     No back button: iOS uses .navigationBarBackButtonHidden(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/room_creation"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_glass"
    android:orientation="vertical">

    <!-- Nav bar: inline centred title only. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Join Codes"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- StepHeader 3 of 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_progress_on" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:text="Step 4 of 4"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:text="Your event is ready"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingMultiplier="1.25"
                android:text="Share the attendee code widely. Share the staff code carefully."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- ===== Attendee code ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.04"
                android:text="ATTENDEE CODE"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/room_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ios_code_blue"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:text="ABC123"
                android:textColor="@color/text_primary"
                android:textSize="46sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <com.example.firstlink.widget.DraggableMaterialButton
                    android:id="@+id/copy_room_code_button"
                    style="@style/Widget.FirstLink.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="Copy"
                    android:textColor="@color/brand_primary"
                    android:textSize="17sp"
                    android:elevation="0dp"
                    app:backgroundTint="@color/card_surface"
                    app:cornerRadius="22dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_sf_doc_on_doc"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/brand_primary"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.example.firstlink.widget.DraggableMaterialButton
                    android:id="@+id/share_room_code_button"
                    style="@style/Widget.FirstLink.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="Share"
                    android:textColor="@color/brand_primary"
                    android:textSize="17sp"
                    android:elevation="0dp"
                    app:backgroundTint="@color/card_surface"
                    app:cornerRadius="22dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_sf_square_and_arrow_up"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/brand_primary"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="36dp"
                android:lineSpacingMultiplier="1.25"
                android:text="Anyone with this code can report emergencies and request help."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- ===== Staff code ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="7dp"
                android:letterSpacing="0.04"
                android:text="STAFF CODE"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/staff_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_ios_code_orange"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:text="STAFF8"
                android:textColor="@color/text_primary"
                android:textSize="46sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <com.example.firstlink.widget.DraggableMaterialButton
                    android:id="@+id/copy_staff_code_button"
                    style="@style/Widget.FirstLink.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="Copy"
                    android:textColor="@color/brand_primary"
                    android:textSize="17sp"
                    android:elevation="0dp"
                    app:backgroundTint="@color/card_surface"
                    app:cornerRadius="22dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_sf_doc_on_doc"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/brand_primary"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.example.firstlink.widget.DraggableMaterialButton
                    android:id="@+id/share_staff_code_button"
                    style="@style/Widget.FirstLink.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="Share"
                    android:textColor="@color/brand_primary"
                    android:textSize="17sp"
                    android:elevation="0dp"
                    app:backgroundTint="@color/card_surface"
                    app:cornerRadius="22dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_sf_square_and_arrow_up"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/brand_primary"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="36dp"
                android:lineSpacingMultiplier="1.25"
                android:text="Staff can see every incident and resolve them. Share carefully."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned bottom action bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <com.example.firstlink.widget.DraggableMaterialButton
            android:id="@+id/open_checkin_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Open Check-In"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="0dp"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="28dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_sf_checkmark_circle"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeWidth="0dp" />
    </LinearLayout>
</LinearLayout>
