<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/room_creation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.FirstLink.BackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/room_code_title_text_view"
            style="@style/TextAppearance.FirstLink.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="20dp"
            android:text="Your event is ready" />

        <TextView
            android:id="@+id/room_code_description"
            style="@style/TextAppearance.FirstLink.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:text="Share the attendee code with participants. Share the staff code only with trusted event staff." />

        <!-- Attendee code: the celebratory moment, so it gets the bold gradient card
             with a big monospace readout and a frosted control bar for the action. -->
        <LinearLayout
            android:id="@+id/room_code_card"
            style="@style/Widget.FirstLink.HeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/TextAppearance.FirstLink.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Attendee code"
                android:textColor="@color/on_gradient_muted" />

            <TextView
                android:id="@+id/room_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="ABC123"
                android:textColor="@color/on_gradient"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.FirstLink.HeroBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Attendees enter this to join" />

            <!-- Frosted control bar: label on the left, action pill on the right. -->
            <LinearLayout
                style="@style/Widget.FirstLink.FrostedBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share with attendees"
                    android:textColor="@color/on_gradient_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy_room_code_button"
                    style="@style/Widget.FirstLink.Button.OnGradient"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Copy"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Staff code stays a calm outlined card: it is a security-sensitive secondary code,
             not a thing to shout about. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/staff_code_card"
            style="@style/Widget.FirstLink.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/warning_container"
            app:strokeColor="@color/warning_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/TextAppearance.FirstLink.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff code"
                    android:textColor="@color/warning_dark_text" />

                <TextView
                    android:id="@+id/staff_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="STAFF8"
                    android:textColor="@color/warning"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Anyone who joins with this code gets staff access. Share it carefully."
                    android:textColor="@color/warning_body_text"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy_staff_code_button"
                    style="@style/Widget.FirstLink.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="Copy staff code"
                    android:textColor="@color/warning_dark_text"
                    android:textSize="15sp"
                    app:icon="@android:drawable/ic_menu_set_as"
                    app:iconTint="@color/warning_dark_text" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_checkin_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:text="Open Check-In"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
