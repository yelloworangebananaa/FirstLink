<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attendee_join_event"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ImageButton
        android:id="@+id/back_button"
        style="@style/Widget.FirstLink.BackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The join code is the whole point of this screen, so it gets the bold card. -->
    <LinearLayout
        android:id="@+id/join_hero_card"
        style="@style/Widget.FirstLink.HeroCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="30dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button">

        <TextView
            style="@style/TextAppearance.FirstLink.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendee check-in"
            android:textColor="@color/on_gradient_muted" />

        <TextView
            android:id="@+id/join_event_title"
            style="@style/TextAppearance.FirstLink.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Join Event" />

        <TextView
            android:id="@+id/join_event_subtitle"
            style="@style/TextAppearance.FirstLink.HeroBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter the code the organizer shared with you." />

        <!-- Frosted control bar holding the code entry + action. -->
        <LinearLayout
            android:id="@+id/join_action_bar"
            style="@style/Widget.FirstLink.FrostedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="14dp">

            <EditText
                android:id="@+id/join_code_edit_text"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@drawable/bg_field_on_gradient"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="ABC123"
                android:inputType="textCapCharacters"
                android:letterSpacing="0.24"
                android:maxLength="8"
                android:textColor="@color/on_gradient"
                android:textColorHint="@color/on_gradient_faint"
                android:textSize="26sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/join_event_button"
                style="@style/Widget.FirstLink.Button.OnGradient"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="Join Event"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/join_event_hint"
        style="@style/TextAppearance.FirstLink.PageSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:text="Codes are 6 characters and are not case sensitive."
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/join_hero_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
