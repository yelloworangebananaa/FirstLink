<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendee_help"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.FirstLink.BackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:id="@+id/attendee_help_header_card"
            style="@style/Widget.FirstLink.HeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.FirstLink.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Non-emergency"
                android:textColor="@color/on_gradient_muted" />

            <TextView
                android:id="@+id/attendee_help_title"
                style="@style/TextAppearance.FirstLink.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Request Help" />

            <TextView
                style="@style/TextAppearance.FirstLink.HeroBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Event staff will see this request and come find you." />
        </LinearLayout>

        <TextView
            android:id="@+id/attendee_help_location_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="26dp"
            android:text="Location" />

        <Spinner
            android:id="@+id/attendee_help_location_spinner"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="18dp"
            android:paddingEnd="46dp" />

        <TextView
            android:id="@+id/attendee_help_description_label"
            style="@style/TextAppearance.FirstLink.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="22dp"
            android:text="Description" />

        <EditText
            android:id="@+id/attendee_help_description"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Describe what you need help with..."
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:padding="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendee_help_send_button"
            style="@style/Widget.FirstLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="Send Request"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
