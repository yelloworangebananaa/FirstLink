<?xml version="1.0" encoding="utf-8"?>
<!--
  Tier 1 glass: the full-height hero surface (home, join, room codes).

  Deliberately the THINNEST glass in the app. It covers most of the screen, so at card
  opacity it would simply repaint the page white and erase the blooms it is supposed to
  be floating over. At 56/35% the field still reads straight through it.

  Two rims: the outer one is the lit edge, the inner one (offset 1dp) gives that edge
  thickness. A single stroke reads as a drawn border; two read as a pane with depth.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_sheet_bottom"
                android:startColor="@color/glass_sheet_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim_inner" />
        </shape>
    </item>

</layer-list>
