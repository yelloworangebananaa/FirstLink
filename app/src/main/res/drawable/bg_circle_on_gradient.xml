<?xml version="1.0" encoding="utf-8"?>
<!-- Circular glass badge: the logo lockup on home, and the numbered step markers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_sheen_bottom"
        android:startColor="@color/glass_sheen_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_rim" />
</shape>
