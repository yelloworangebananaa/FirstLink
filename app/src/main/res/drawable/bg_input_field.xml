<?xml version="1.0" encoding="utf-8"?>
<!--
  Input well. The sheen is INVERTED relative to every other glass surface - darker at the
  top, lighter at the bottom - which is the only cue a flat XML shape has for "recessed".
  Panels catch the light on their top edge; holes are in shadow at theirs.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_well_bottom"
                android:startColor="@color/glass_well_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/border_light" />
        </shape>
    </item>

</layer-list>
