<?xml version="1.0" encoding="utf-8"?>
<!-- Small glass pill inside a panel: one step further up the opacity ladder than the
     panel it sits on, which is what makes it read as a separate object. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/glass_sheen_bottom"
        android:startColor="@color/glass_sheen_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_rim_inner" />
</shape>
