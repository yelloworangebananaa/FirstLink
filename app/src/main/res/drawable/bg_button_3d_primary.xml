<?xml version="1.0" encoding="utf-8"?>
<!-- Primary CTA fill for the one screen whose button is a plain AppCompatButton rather than
     a MaterialButton (creator.xml's create_event_btn, typed as Button in Java). Flat accent
     pill, darkening on press - same material as Widget.FirstLink.Button.Primary. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/brand_primary_dark" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/brand_primary" />
        </shape>
    </item>

</selector>
