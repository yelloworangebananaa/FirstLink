<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary CTA fill for creator.xml's create_event_btn - the one button in the app typed as
  a plain AppCompatButton in Java, so it cannot inherit Widget.FirstLink.Button.Primary.

  This is the only place the logo gradient itself is painted: #0A78FF at the top down to
  #0052E0 at the bottom, i.e. the shield read top-to-bottom. Everywhere else the accent is
  the flat brand blue, because a gradient on every button stops being a highlight.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/brand_primary_dark"
                android:startColor="@color/brand_primary"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/brand_primary_dark"
                android:startColor="@color/brand_primary_light"
                android:type="linear" />
        </shape>
    </item>

</selector>
