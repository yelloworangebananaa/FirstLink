<?xml version="1.0" encoding="utf-8"?>
<!-- Tier 2 glass: content you actually have to read. Opaque enough to carry body text
     over any bloom, still translucent enough to tint with whatever is behind it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_card_bottom"
                android:startColor="@color/glass_card_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim_inner" />
        </shape>
    </item>

</layer-list>
