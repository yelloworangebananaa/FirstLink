<?xml version="1.0" encoding="utf-8"?>
<!--
  Spinner popup. Without this the platform draws its own hard-cornered opaque white sheet,
  which was the one surface in the app that ignored the glass language entirely.

  It uses the dialog surface rather than a card tier because that is what it is: a floating
  overlay, the same layer dialogs live on. The 8dp of vertical padding keeps the first and
  last rows off the rounded corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/dialog_glass_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_rim" />
    <padding
        android:left="0dp"
        android:top="8dp"
        android:right="0dp"
        android:bottom="8dp" />
</shape>
