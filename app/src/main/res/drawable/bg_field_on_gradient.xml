<?xml version="1.0" encoding="utf-8"?>
<!-- Text field sitting inside a grouped panel. The panel is already grey, so the field takes
     the page colour instead - an input has to read as a well you can type into, and grey-on-grey
     reads as decoration. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@color/frosted_chip_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/on_gradient_hairline" />
</shape>
