<?xml version="1.0" encoding="utf-8"?>
<!-- List-item surface. Data-dense rows stay plain white for legibility. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_surface" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/border_light" />
    <padding
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp" />
</shape>
