<?xml version="1.0" encoding="utf-8"?>
<!--
  Tier 3 glass: the control panel. Sits INSIDE a sheet or card, so it is the most solid
  tier - opacity climbing as you go deeper into the stack is the whole depth cue, and it
  is the reason none of these surfaces need a drop shadow.

  Name kept because Widget.FirstLink.FrostedBar and 5 layouts resolve against it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_sheen_bottom"
                android:startColor="@color/glass_sheen_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_rim_inner" />
        </shape>
    </item>

</layer-list>
