<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      FirstLink theme: Apple-style liquid glass, built on the two colours in the logo.

      The rules the whole app follows:

        * The page is never flat. android:windowBackground is the bloomed field, so even
          the slide transition between activities shows it rather than flashing white.
        * Depth comes from OPACITY, not shadow. sheet (56%) < card (84%) < panel (90%)
          < chip. Stacking those is what reads as layered glass; drop shadows on a
          translucent surface just bleed grey through the fill.
        * Shadows are reserved for the solid accent pills, and each is tinted with its own
          hue so it reads as light spilling out from under the button (API 28+).
        * Corners are large and continuous-ish. Buttons are true 50% stadiums so a pill
          stays a pill at every height the layouts use (48dp -> 78dp).
    -->
    <style name="Base.Theme.FirstLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>

        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border_light</item>
        <!-- Material tints any raised surface with the primary hue ("tonal elevation"),
             which would fight the glass: a lifted pane is the same glass as a flat one,
             only more of it. Off app-wide. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- The field, painted by the window itself. -->
        <item name="android:windowBackground">@drawable/bg_page_glass</item>

        <!-- Matched to the top of the field so the system bars dissolve into it. -->
        <item name="android:statusBarColor">@color/page_top</item>
        <item name="android:navigationBarColor">@color/page_bottom</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FirstLink.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FirstLink.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.FirstLink.Large</item>

        <!-- Every unstyled filled MaterialButton in the app picks this up automatically. -->
        <item name="materialButtonStyle">@style/Widget.FirstLink.Button.Primary</item>

        <!-- Ticks, radios and text cursors all land on glass, so they take the accent. -->
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:textColorHighlight">@color/brand_primary_container</item>

        <!-- Slide+fade "push" transition applied to every startActivity()/finish() call. -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation.FirstLink</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FirstLink.Dialog</item>
    </style>

    <!-- Dialogs are the one layer with a REAL backdrop blur: util/GlassBlur.java Gaussian-
         blurs the page behind them on API 31+. So the surface is held just short of opaque
         to let that blur read through, and the scrim is dialled back from the stock 0.6 -
         a heavy dim would simply crush the blur into grey. -->
    <style name="ThemeOverlay.FirstLink.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/dialog_glass_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_glass_surface</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_body</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.FirstLink.Large</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FirstLink.Button.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FirstLink.Button.Dialog.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.FirstLink.Button.Dialog.Negative</item>
    </style>

    <!-- Same dialog, red affirmative. Passed explicitly at the two call sites whose positive
         action is genuinely destructive/urgent, since a theme cannot vary per dialog. -->
    <style name="ThemeOverlay.FirstLink.Dialog.Danger">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FirstLink.Button.Dialog.Positive.Danger</item>
    </style>

    <style name="Theme.FirstLink" parent="Base.Theme.FirstLink" />

    <style name="ShapeAppearance.FirstLink.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.FirstLink.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.FirstLink.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">30dp</item>
    </style>

    <!-- True stadium. A percentage corner keeps every button a full pill no matter what
         height the layout gives it (they range 48dp -> 78dp across the app), which a fixed
         dp radius cannot do. -->
    <style name="ShapeAppearance.FirstLink.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===================== Buttons ===================== -->

    <!-- Two tiers. SOLID pills (Primary/Danger/Success) are the one opaque material in the
         app - a call-for-help button must never be see-through - and each casts a shadow
         tinted with its own hue. GLASS pills (Neutral/Outlined/Ghost) are translucent with
         a lit rim, sit flat, and borrow the accent for their label instead of their fill. -->
    <style name="Widget.FirstLink.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@animator/button_press_feedback</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FirstLink.Pill</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FirstLink.Button.Primary" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">6dp</item>
        <item name="elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/brand_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/brand_glow</item>
    </style>

    <style name="Widget.FirstLink.Button.Danger" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">6dp</item>
        <item name="elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/danger_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/danger_glow</item>
    </style>

    <style name="Widget.FirstLink.Button.Success" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/success</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">6dp</item>
        <item name="elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/success_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/success_glow</item>
    </style>

    <!-- Glass tier, muted label: "Cancel"-weight actions that should recede. -->
    <style name="Widget.FirstLink.Button.Neutral" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <!-- Glass tier, branded label. Historically the "outlined" style; the rim is back, but
         as the lit edge of the glass rather than as a drawn Material outline. Name kept so
         existing layouts keep resolving. -->
    <style name="Widget.FirstLink.Button.Outlined" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <!-- Dialog action buttons. Material3's default button bar uses compact TEXT buttons;
         these restore real pills. Insets are zeroed because MaterialButton's default 6dp
         vertical insets eat into a wrap_content dialog button and squash the pill. -->
    <style name="Widget.FirstLink.Button.Dialog" parent="Widget.FirstLink.Button">
        <item name="android:minWidth">104dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.FirstLink.Button.Dialog.Positive">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">4dp</item>
        <item name="elevation">4dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/brand_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/brand_glow</item>
    </style>

    <!-- Destructive confirms (end event, approve a real 911 call) opt into this via a
         per-call theme overlay on MaterialAlertDialogBuilder. -->
    <style name="Widget.FirstLink.Button.Dialog.Positive.Danger">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/danger_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/danger_glow</item>
    </style>

    <style name="Widget.FirstLink.Button.Dialog.Negative">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <style name="Widget.FirstLink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- The one primary action inside a glass panel. Solid accent: a glass pill on a glass
         panel has nothing to contrast against. -->
    <style name="Widget.FirstLink.Button.OnGradient" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">6dp</item>
        <item name="elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/brand_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/brand_glow</item>
    </style>

    <!-- Secondary action in the same panel: glass on glass, kept legible by the rim and
         the accent label rather than by fill contrast. -->
    <style name="Widget.FirstLink.Button.OnGradientGhost" parent="Widget.FirstLink.Button">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <!-- ===================== Surfaces ===================== -->

    <!-- Tier 1: the full-height hero pane (home, join, room codes). Thin glass, so the
         blooms in the field still read straight through it. -->
    <style name="Widget.FirstLink.HeroCard" parent="">
        <item name="android:background">@drawable/bg_glass_sheet</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Page header band: the same glass, tinted with the logo blue. -->
    <style name="Widget.FirstLink.HeaderCard" parent="Widget.FirstLink.HeroCard">
        <item name="android:background">@drawable/bg_header_hero</item>
    </style>

    <!-- Emergency headers keep a red wash. Urgency is content here, so it earns colour an
         ordinary page header does not. -->
    <style name="Widget.FirstLink.HeaderCard.Danger">
        <item name="android:background">@drawable/bg_header_danger</item>
    </style>

    <!-- Tier 3: grouped controls. The most solid glass in the stack, because it always
         sits on top of one of the tiers above. -->
    <style name="Widget.FirstLink.FrostedBar" parent="">
        <item name="android:background">@drawable/bg_frosted_bar</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Tier 2 as a MaterialCardView. Elevation is 0 on purpose: a shadow behind a
         translucent card is visible THROUGH it as a grey wash, which is exactly the
         "muddy glass" failure. The rim and the opacity step do the lifting instead. -->
    <style name="Widget.FirstLink.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border</item>
    </style>

    <style name="Widget.FirstLink.BackButton" parent="">
        <item name="android:background">@drawable/bg_circle_brand_soft</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/brand_primary</item>
    </style>

    <!-- ===================== Type ===================== -->

    <!-- The glass carries no hierarchy of its own, so the type ramp is load-bearing.
         Apple's display scale mapped onto a phone: 34sp large title with tight tracking
         and 1.1 leading (what makes a big title read as one object), 17sp body, 13sp
         caption. Negative tracking only on the display sizes - at 13sp it hurts. -->

    <style name="TextAppearance.FirstLink.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.FirstLink.Hero" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_gradient</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.FirstLink.HeroBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/on_gradient_muted</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.FirstLink.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.FirstLink.PageSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.FirstLink.FieldLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="WindowAnimation.FirstLink" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!-- Settings screen: iOS-style grouped list pieces. -->
    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">36dp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginEnd">36dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsFooter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">36dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginEnd">36dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@drawable/bg_ios_group</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="SettingsValueRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="SettingsSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_ios_seg_item</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
