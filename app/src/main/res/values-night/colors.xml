<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark glass. Every token in values/colors.xml is restated here, which is why dark mode
  costs one file instead of sixteen: no layout hardcodes a colour, so re-pointing the
  tokens re-skins the whole app.

  Two things flip, and only two:
    - The field goes near-black and the blooms of logo blue get *brighter*, not dimmer.
      A dark glassmorphic page is mostly the blooms; drop them and the glass has nothing
      to hold.
    - Glass stops being white-at-70% and becomes white-at-10%. The rim does the work
      instead of the fill, so rim alpha roughly doubles relative to the fill.

  The accent lifts #0A6CFC -> #0A84FF for the same reason Apple's does: a mid-blue that
  reads as confident on white goes muddy on black.
-->
<resources>
    <color name="brand_primary">#0A84FF</color>
    <color name="brand_primary_dark">#0060D8</color>
    <color name="brand_primary_light">#5AACFF</color>
    <color name="brand_primary_container">#330A84FF</color>
    <color name="brand_on_primary_container">#9CCBFF</color>
    <color name="brand_border_soft">#660A84FF</color>

    <color name="page_top">#080C15</color>
    <color name="page_mid">#0A1019</color>
    <color name="page_bottom">#04070E</color>

