<?xml version="1.0" encoding="utf-8"?>
<!-- Dark grouped glass panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_sheen_bottom"
                android:startColor="@color/glass_sheen_top"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/glass_rim" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <stroke android:width="1dp" android:color="@color/glass_rim_inner" />
        </shape>
    </item>
</layer-list>
