<?xml version="1.0" encoding="utf-8"?>
<!-- Dark prominent danger capsule. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="@color/danger_dark_text" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="@color/danger" /><stroke android:width="1dp" android:color="@color/danger_border" /></shape>
    </item>
</selector>
